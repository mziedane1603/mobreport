rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // الشيتات المحفوظة: القراءة للجميع بدون تسجيل دخول، والحفظ والحذف للمسؤول المسجل دخول فقط
    match /datasets/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
